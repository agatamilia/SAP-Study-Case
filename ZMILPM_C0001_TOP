  LOOP AT SCREEN.
    CASE screen-group1.
      WHEN 'NOT'.
        IF rb_not = 'X'.
          screen-input = 1.
        ELSE.
          screen-input = 0.
          CLEAR s_not[].
        ENDIF.
      WHEN 'MO'.
        IF rb_mo = 'X'.
          screen-input = 1.
        ELSE.
          screen-input = 0.
          CLEAR s_mo[].
        ENDIF.
    ENDCASE.
    MODIFY SCREEN.
  ENDLOOP.

