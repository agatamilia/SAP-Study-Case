*&---------------------------------------------------------------------*
*& Form f_gserverdata
*&---------------------------------------------------------------------*

FORM f_gserverdata .
  DATA lv_line TYPE string.

  CLEAR t_data.

  "cek input kosong
  IF p_srv IS INITIAL.
    MESSAGE 'Path server belum diisi' TYPE 'E'.
  ENDIF.

  OPEN DATASET p_srv FOR INPUT IN TEXT MODE ENCODING DEFAULT.

  IF sy-subrc <> 0.
    MESSAGE 'File tidak bisa dibuka di server' TYPE 'E'.
  ENDIF.

  DO.
    READ DATASET p_srv INTO lv_line.
    IF sy-subrc <> 0. " sebanyak data nanti berenti klo kosong
      EXIT.
    ENDIF.

    APPEND lv_line TO t_data.
  ENDDO.

  CLOSE DATASET p_srv.
ENDFORM.
