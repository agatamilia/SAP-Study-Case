FORM normalize_unit CHANGING p_unit TYPE meins
                             p_error TYPE abap_bool
                             p_msg TYPE string
                             p_no TYPE char10.

  TRANSLATE p_unit TO UPPER CASE.
  CONDENSE p_unit.

  "manual mapping unit PC(WAJIB kalau dari CSV bebas)
  CASE p_unit.
    WHEN 'PCS' OR 'PC' OR 'PCE'.
      p_unit = 'PC'.
  ENDCASE.

  CALL FUNCTION 'CONVERSION_EXIT_CUNIT_INPUT'
    EXPORTING
      input  = p_unit
    IMPORTING
      output = p_unit
    EXCEPTIONS
      OTHERS = 1.

  SELECT SINGLE msehi "field uom
  FROM t006 "table sap uom
  INTO @DATA(lv_check)
  WHERE msehi = @p_unit.

  IF sy-subrc <> 0.
    p_error = abap_true.
    p_msg = 'Unit tidak terdaftar di SAP'.
  ENDIF.

ENDFORM.

FORM f_rfile.

  DATA: lv_qty      TYPE string,
*        lv_prev_key TYPE string,
*        lv_curr_key TYPE string,
*        lv_no       TYPE i VALUE 1,
        lv_date_str TYPE string,
        lv_day      TYPE string,
        lv_mon      TYPE string,
        lv_year     TYPE string,
        lv_err      TYPE abap_bool,
        lv_msg      TYPE string,
        lv_unit     TYPE meins.

  "========================
  " 1. PARSE FILE > t_up
  "========================
  LOOP AT t_data INTO d_line.

    CLEAR: x_up, t_split.

    "skip header read
    IF sy-tabix = 1.
      CONTINUE.
    ENDIF.

    SPLIT d_line AT ';' INTO TABLE t_split.
    "mapping array to struct x_up
    READ TABLE t_split INDEX 1 INTO x_up-no.
    READ TABLE t_split INDEX 2 INTO x_up-doc_type.
    READ TABLE t_split INDEX 3 INTO x_up-vendor.
    READ TABLE t_split INDEX 4 INTO x_up-purch_org.
    READ TABLE t_split INDEX 5 INTO x_up-pur_group.
    READ TABLE t_split INDEX 6 INTO x_up-material.
    READ TABLE t_split INDEX 7 INTO x_up-plant.

    "STRING → DIKONVERSI → NUMERIC
    READ TABLE t_split INDEX 8 INTO lv_qty.
    x_up-quantity = lv_qty. "

    READ TABLE t_split INDEX 9 INTO lv_unit.

    PERFORM normalize_unit CHANGING lv_unit lv_err lv_msg x_up-no.

    x_up-po_unit = lv_unit.

    READ TABLE t_split INDEX 10 INTO x_up-gl_account.
    READ TABLE t_split INDEX 11 INTO x_up-bus_area.
    READ TABLE t_split INDEX 12 INTO x_up-costcenter.
*    READ TABLE t_split INDEX 13 INTO x_up-pmnttrms.   " Payment Terms
    READ TABLE t_split INDEX 13 INTO lv_date_str.

    IF lv_date_str IS NOT INITIAL.

      CONDENSE lv_date_str.

      REPLACE ALL OCCURRENCES OF '/' IN lv_date_str WITH '.'.
      REPLACE ALL OCCURRENCES OF '-' IN lv_date_str WITH '.'.

      SPLIT lv_date_str AT '.' INTO lv_day lv_mon lv_year.

      IF lv_year IS INITIAL. " berarti format tanpa separator
        lv_day  = lv_date_str+0(2).
        lv_mon  = lv_date_str+2(2).
        lv_year = lv_date_str+4(4).
      ENDIF.

      x_up-deliv_date = |{ lv_year }{ lv_mon WIDTH = 2 PAD = '0' }{ lv_day WIDTH = 2 PAD = '0' }|. "plus 0 jika 1 char

    ENDIF.

    " NORMALISASI=====================
    "alpha IN = external to internal 0 for fixed length | cek: domain > routine
    x_up-vendor     = |{ x_up-vendor ALPHA = IN }|.
    x_up-material   = |{ x_up-material ALPHA = IN }|.
    x_up-gl_account = |{ x_up-gl_account ALPHA = IN }|.
    x_up-costcenter = |{ x_up-costcenter ALPHA = IN }|.




    " GROUPING document (NO)================
*    "current key
*    CONCATENATE x_up-doc_type x_up-vendor x_up-purch_org x_up-pur_group
*      INTO lv_curr_key SEPARATED BY '|'.
*
*    "prev key
*    IF lv_prev_key IS INITIAL.
*      lv_prev_key = lv_curr_key.
*
*    ELSEIF lv_prev_key <> lv_curr_key.
*      lv_no = lv_no + 1.
*      lv_prev_key = lv_curr_key.
*    ENDIF.
*
*    x_up-no = lv_no.
*
    APPEND x_up TO t_up.

  ENDLOOP.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form f_check XXXXXXXXXXXXXXXXXXXXXX
*&---------------------------------------------------------------------*

FORM f_check.

  DATA: lv_error     TYPE abap_bool,
        lv_msg       TYPE string,
        lv_unit      TYPE meins,
        lv_day       TYPE scal-indicator,
        ls_header    TYPE bapimepoheader,
        ls_headerx   TYPE bapimepoheaderx,
        lt_item      TYPE TABLE OF bapimepoitem,
        lt_itemx     TYPE TABLE OF bapimepoitemx,
        lt_sched     TYPE TABLE OF bapimeposchedule,
        lt_schedx    TYPE TABLE OF bapimeposchedulx,
        lt_return    TYPE TABLE OF bapiret2,
        lv_item      TYPE posnr,

        lt_vendor    TYPE SORTED TABLE OF lfa1-lifnr WITH UNIQUE KEY table_line,
        lt_mat       TYPE SORTED TABLE OF mara-matnr WITH UNIQUE KEY table_line,
        lt_plant     TYPE SORTED TABLE OF t001w-werks WITH UNIQUE KEY table_line,

        lt_vendor_db TYPE TABLE OF lfa1-lifnr,
        lt_mat_db    TYPE TABLE OF mara-matnr,
        lt_plant_db  TYPE TABLE OF t001w-werks,
        lt_account   TYPE TABLE OF bapimepoaccount,
        lt_accountx  TYPE TABLE OF bapimepoaccountx.
*        ls_account   TYPE bapimepoaccount,
*        ls_accountx  TYPE bapimepoaccountx.

  CLEAR: t_alv, gt_error.
  REFRESH: t_alv, gt_error.

  IF t_up IS INITIAL.
    MESSAGE 'No data uploaded' TYPE 'E'.
    EXIT.
  ENDIF.

  "========================
  " COLLECT UNIQUE KEYS
  "========================
  LOOP AT t_up INTO DATA(ls_up).
    IF ls_up-vendor IS NOT INITIAL.
      INSERT ls_up-vendor INTO TABLE lt_vendor."insert : udah sorted table
    ENDIF.

    IF ls_up-material IS NOT INITIAL.
      INSERT CONV mara-matnr( ls_up-material ) INTO TABLE lt_mat.
    ENDIF.

    IF ls_up-plant IS NOT INITIAL.
      INSERT ls_up-plant INTO TABLE lt_plant.
    ENDIF.
  ENDLOOP.

  "Vendor
  IF lt_vendor IS NOT INITIAL.
    SELECT lifnr FROM lfa1
    INTO TABLE lt_vendor_db
    FOR ALL ENTRIES IN lt_vendor
    WHERE lifnr = lt_vendor-table_line.
  ENDIF.

  "Material
  IF lt_mat IS NOT INITIAL.
    SELECT matnr FROM mara
      INTO TABLE lt_mat_db
      FOR ALL ENTRIES IN lt_mat
      WHERE matnr = lt_mat-table_line.
  ENDIF.

  "Plant
  IF lt_plant IS NOT INITIAL.
    SELECT werks FROM t001w
      INTO TABLE lt_plant_db
      FOR ALL ENTRIES IN lt_plant
      WHERE werks = lt_plant-table_line.
  ENDIF.



  LOOP AT t_up INTO x_up.

    CLEAR: x_alv, lv_error, lv_msg, lv_unit,  lt_item, lt_itemx, lt_sched, lt_schedx, lt_return.

    MOVE-CORRESPONDING x_up TO x_alv.

    "========================
    " 1. BASIC VALIDATION
    "========================
    IF x_up-no IS INITIAL.
      PERFORM add_error USING x_up-no 'NO' 'Wajib diisi'
            CHANGING lv_error lv_msg.
    ENDIF.
    IF x_up-doc_type IS INITIAL.
      PERFORM add_error USING x_up-no 'DOC_TYPE' 'Wajib diisi'
            CHANGING lv_error lv_msg.
    ENDIF.

    IF x_up-vendor IS INITIAL.
      PERFORM add_error USING x_up-no 'VENDOR' 'Wajib diisi'
            CHANGING lv_error lv_msg.
    ENDIF.

    IF x_up-material IS INITIAL.
      PERFORM add_error USING x_up-no 'MATERIAL' 'Wajib diisi'
            CHANGING lv_error lv_msg.
    ENDIF.

    IF x_up-quantity IS INITIAL OR x_up-quantity <= 0.
      PERFORM add_error USING x_up-no 'QUANTITY' 'Tidak valid'
            CHANGING lv_error lv_msg.
    ENDIF.

    IF x_up-deliv_date IS INITIAL.
      PERFORM add_error USING x_up-no 'DELIV_DATE' 'Wajib diisi'
            CHANGING lv_error lv_msg.
    ENDIF.

    "========================
    " WEEKEND check
    "========================
    IF x_up-deliv_date IS NOT INITIAL.

*      DATA(lv_dow) = ( x_up-deliv_date - '19991227' ) MOD 7. "senin ref tgl
*
*      IF lv_dow = 5 OR lv_dow = 6.
*        PERFORM add_error USING x_up-no 'DELIV_DATE' 'Tidak boleh weekend'
*              CHANGING lv_error lv_msg.
*      ENDIF.
      CALL FUNCTION 'DATE_COMPUTE_DAY'
        EXPORTING
          date = x_up-deliv_date
        IMPORTING
          day  = lv_day.

      " 1 = Monday ... 7 = Sunday
      IF lv_day = 6 OR lv_day = 7.
        PERFORM add_error USING x_up-no 'DELIV_DATE' 'Tidak boleh weekend'
              CHANGING lv_error lv_msg.
      ENDIF.

    ENDIF.

    "========================
    " MASTER DATA CHECK
    "========================
    READ TABLE lt_vendor_db WITH KEY table_line = x_up-vendor TRANSPORTING NO FIELDS. "hanya baca, klo into lgsg kecopy
    IF sy-subrc <> 0 AND x_up-vendor IS NOT INITIAL.
      PERFORM add_error USING x_up-no 'VENDOR' 'Tidak ditemukan'
            CHANGING lv_error lv_msg.
    ENDIF.

    READ TABLE lt_mat_db WITH KEY table_line = x_up-material TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0 AND x_up-material IS NOT INITIAL.
      PERFORM add_error USING x_up-no 'MATERIAL' 'Tidak ditemukan'
            CHANGING lv_error lv_msg.
    ENDIF.

    READ TABLE lt_plant_db WITH KEY table_line = x_up-plant TRANSPORTING NO FIELDS.
    IF sy-subrc <> 0 AND x_up-plant IS NOT INITIAL.
      PERFORM add_error USING x_up-no 'PLANT' 'Tidak valid'
            CHANGING lv_error lv_msg.
    ENDIF.

    "========================
    " UNIT CONVERSION
    "========================
    lv_unit = x_up-po_unit.

    PERFORM normalize_unit CHANGING lv_unit lv_error lv_msg x_up-no.
    x_up-po_unit = lv_unit.

    "========================
    " BAPI CHECK
    "========================
    IF lv_error IS INITIAL.

      CLEAR lv_item.
      lv_item = 10.

      ls_header-doc_type  = x_up-doc_type.
      ls_header-vendor    = x_up-vendor.
      ls_header-purch_org = x_up-purch_org.
      ls_header-pur_group = x_up-pur_group.

      ls_headerx-doc_type  = 'X'.
      ls_headerx-vendor    = 'X'.
      ls_headerx-purch_org = 'X'.
      ls_headerx-pur_group = 'X'.


      APPEND VALUE #(
          po_item  = lv_item
          material = x_up-material
          plant    = x_up-plant
          quantity = x_up-quantity
          po_unit  = x_up-po_unit
          info_upd = 'X' "auto sap nett price | bapi: POITEM-INFO_UPD
        ) TO lt_item.

      APPEND VALUE #(
        po_item  = lv_item
        po_itemx = 'X'
        material = 'X'
        plant    = 'X'
        quantity = 'X'
        po_unit  = 'X'
        info_upd = 'X'
      ) TO lt_itemx.

      APPEND VALUE #(
        po_item       = lv_item
        sched_line    = '0001' "xxxxxx
        delivery_date = x_up-deliv_date
        quantity      = x_up-quantity
      ) TO lt_sched.

      APPEND VALUE #(
        po_item    = lv_item
        sched_line = '0001'
        po_itemx   = 'X'
        delivery_date = 'X'
        quantity   = 'X'
      ) TO lt_schedx.

      APPEND VALUE #(
        po_item    = lv_item
        serial_no  = '01'
        gl_account = x_up-gl_account
        costcenter = x_up-costcenter
      ) TO lt_account.

      APPEND VALUE #(
        po_item    = lv_item
        serial_no  = '01'
        po_itemx   = 'X'
        gl_account = 'X'
        costcenter = 'X'
      ) TO lt_accountx.
      "xxxxxx
      CALL FUNCTION 'BAPI_PO_CREATE1'
        EXPORTING
          poheader    = ls_header
          poheaderx   = ls_headerx
          testrun     = 'X'
        TABLES
          return      = lt_return
          poitem      = lt_item
          poitemx     = lt_itemx
          poschedule  = lt_sched
          poschedulex = lt_schedx
          poaccount   = lt_account
          poaccountx  = lt_accountx.

      LOOP AT lt_return INTO DATA(ls_ret)
        WHERE type CA 'AE'. "A= abort
        PERFORM add_error USING x_up-no 'BAPI'
              ls_ret-message
              CHANGING lv_error lv_msg.
      ENDLOOP.

    ENDIF.

    "========================
    " 6. FINAL STATUS
    "========================
    IF lv_error = abap_true.
      x_alv-status  = 'E'.
      x_alv-icon    = icon_red_light.
      x_alv-message = lv_msg.
    ELSE.
      x_alv-status  = 'P'.
      x_alv-icon    = icon_yellow_light.
      x_alv-message = 'Ready to create PO'.
    ENDIF.

    APPEND x_alv TO t_alv.

  ENDLOOP.

ENDFORM.

*&---------------------------------------------------------------------*
*& Form f_post XXXXXXXXXXXXXXXXXXXXX
*&---------------------------------------------------------------------*
FORM f_post .
  DATA: lt_group   TYPE STANDARD TABLE OF ty_up,
        ls_group   TYPE ty_up,
        lt_item    TYPE TABLE OF bapimepoitem,
        ls_item    TYPE bapimepoitem,
        lt_itemx   TYPE TABLE OF bapimepoitemx,
        ls_itemx   TYPE bapimepoitemx,
        lt_sched   TYPE TABLE OF bapimeposchedule,
        ls_sched   TYPE bapimeposchedule,
        lt_schedx  TYPE TABLE OF bapimeposchedulx,
        ls_schedx  TYPE bapimeposchedulx,
        ls_header  TYPE bapimepoheader,
        ls_headerx TYPE bapimepoheaderx,
        lt_return  TYPE TABLE OF bapiret2,
        ls_return  TYPE bapiret2,
        lv_item    TYPE posnr,
        lv_po      TYPE ebeln,
        lv_msg     TYPE string,
        lt_ready   TYPE STANDARD TABLE OF ty_up.

  "========================
  " 1. BLOCK kalau masih ada ERROR
  "========================
  IF t_alv IS INITIAL.
    PERFORM f_check.
  ENDIF.

  "Kalau masih ada error → STOP
  LOOP AT t_alv INTO DATA(ls_alv) WHERE status = 'E'.
    MESSAGE 'Masih ada data error, tidak bisa POST' TYPE 'E'.
    RETURN.
  ENDLOOP.



  "========================
  " 2. AMBIL HANYA DATA YANG LOLOS (STATUS P)
  "========================
*  CLEAR lt_group.


  LOOP AT t_up INTO DATA(ls_up).
    READ TABLE t_alv INTO DATA(ls_alv2)
      WITH KEY no = ls_up-no.

    IF sy-subrc = 0 AND ls_alv2-status = 'P'.
      APPEND ls_up TO lt_ready.
    ENDIF.
  ENDLOOP.

  IF lt_ready IS INITIAL.
    MESSAGE 'Tidak ada data yang siap di-post' TYPE 'I'.
    RETURN.
  ENDIF.

  lt_group = lt_ready.
  SORT lt_group BY no.
  DELETE ADJACENT DUPLICATES FROM lt_group COMPARING no.

  "========================
  " 3. LOOP GROUP (HEADER PO)
  "========================
  LOOP AT lt_group INTO ls_group.

    CLEAR: ls_header, ls_headerx, lt_item, lt_itemx,
           lt_sched, lt_schedx, lt_return, lv_msg, lv_item.

    "HEADER
    ls_header-doc_type  = ls_group-doc_type.
    ls_header-vendor    = ls_group-vendor.
    ls_header-purch_org = ls_group-purch_org.
    ls_header-pur_group = ls_group-pur_group.
    ls_header-pmnttrms  = '0001'.

    ls_headerx-doc_type  = 'X'.
    ls_headerx-vendor    = 'X'.
    ls_headerx-purch_org = 'X'.
    ls_headerx-pur_group = 'X'.
    ls_headerx-pmnttrms  = 'X'.


    "========================================
    " 5. LOOP ITEM
    "========================================
    LOOP AT lt_ready INTO DATA(ls_up2)
      WHERE no = ls_group-no.

      CLEAR: ls_item, ls_itemx, ls_sched, ls_schedx.

      lv_item = lv_item + 10.


      "------------------------
      " ITEM
      "------------------------
      ls_item-po_item  = lv_item.
      ls_item-material = ls_up2-material.
      ls_item-plant    = ls_up2-plant.
      ls_item-quantity = ls_up2-quantity.
      ls_item-po_unit = ls_up2-po_unit.

      APPEND ls_item TO lt_item.

      "------------------------
      " ITEMX
      "------------------------
      ls_itemx-po_item  = lv_item.
      ls_itemx-po_itemx = 'X'.
      ls_itemx-material = 'X'.
      ls_itemx-plant    = 'X'.
      ls_itemx-quantity = 'X'.
      ls_itemx-po_unit  = 'X'.

      APPEND ls_itemx TO lt_itemx.

      "------------------------
      " SCHEDULE
      "------------------------
      ls_sched-po_item       = lv_item.
      ls_sched-sched_line    = '0001'.
      ls_sched-delivery_date = ls_up2-deliv_date.
      ls_sched-quantity      = ls_up2-quantity.

      APPEND ls_sched TO lt_sched.

      ls_schedx-po_item       = lv_item.
      ls_schedx-sched_line    = '0001'.
      ls_schedx-po_itemx      = 'X'.
      ls_schedx-delivery_date = 'X'.
      ls_schedx-quantity      = 'X'.

      APPEND ls_schedx TO lt_schedx.

    ENDLOOP.

    "========================================
    " 6. CALL BAPI
    "========================================
    CALL FUNCTION 'BAPI_PO_CREATE1'
      EXPORTING
        poheader         = ls_header
        poheaderx        = ls_headerx
      IMPORTING
        exppurchaseorder = lv_po
      TABLES
        return           = lt_return
        poitem           = lt_item
        poitemx          = lt_itemx
        poschedule       = lt_sched
        poschedulex      = lt_schedx.

    "========================================
    " 7. HANDLE RESULT
    "========================================
    CLEAR lv_msg.

    LOOP AT lt_return INTO ls_return
      WHERE type = 'E' OR type = 'A'.
      IF lv_msg IS INITIAL.
        lv_msg = ls_return-message.
      ELSE.
        lv_msg = lv_msg && ' | ' && ls_return-message.
      ENDIF.
    ENDLOOP.

    IF lv_msg IS NOT INITIAL.

      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

      LOOP AT t_alv INTO x_alv WHERE no = ls_group-no.
        x_alv-status  = 'E'.
        x_alv-message = lv_msg.
        x_alv-icon    = icon_red_light.
        MODIFY t_alv FROM x_alv.
      ENDLOOP.

    ELSE.

      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = 'X'.

      LOOP AT t_alv INTO x_alv WHERE no = ls_group-no.
        x_alv-status    = 'S'.
        x_alv-icon      = icon_green_light.
        x_alv-message   = |PO { lv_po } berhasil dibuat|.
        x_alv-po_number = lv_po.
        MODIFY t_alv FROM x_alv.
      ENDLOOP.

    ENDIF.

  ENDLOOP.

ENDFORM.

FORM add_error USING    p_no
                         p_field
                         p_msg
              CHANGING p_error TYPE abap_bool
                       p_text  TYPE string.

  p_error = abap_true.

  IF p_text IS INITIAL.
    p_text = |{ p_field }: { p_msg }|.
  ELSE.
    p_text = |{ p_text } | && |{ p_field }: { p_msg }|.
  ENDIF.


  CLEAR gs_error.
  gs_error-no        = p_no.
  gs_error-fieldname = p_field.
  gs_error-message   = p_msg.

  APPEND gs_error TO gt_error.

ENDFORM.

