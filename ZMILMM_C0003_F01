FORM f_pf_status USING rt_extab TYPE slis_t_extab.
  SET PF-STATUS 'ST_ALV' EXCLUDING rt_extab. "hidden btn
ENDFORM.


*&---------------------------------------------------------------------*
*& Form f_user_command
*&---------------------------------------------------------------------*

FORM f_user_command USING r_ucomm     TYPE sy-ucomm
                          rs_selfield TYPE slis_selfield.

  CASE r_ucomm.

    WHEN 'CHEC'.
      PERFORM f_check.
      rs_selfield-refresh = 'X'.

    WHEN 'POST'.
      PERFORM f_post.
      rs_selfield-refresh = 'X'.

    WHEN '&IC1'. "double click / hotspot

      CLEAR x_alv.

      READ TABLE t_alv INTO x_alv INDEX rs_selfield-tabindex.
      IF sy-subrc <> 0.
        EXIT.
      ENDIF.

      CASE rs_selfield-fieldname.

        WHEN 'MESSAGE'.

          DATA lv_text TYPE string.

          IF lv_text IS NOT INITIAL.

            CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
              EXPORTING
                titel     = 'Detail Error per Field'
                textline1 = lv_text.

          ELSE.

            MESSAGE x_alv-message TYPE 'I'.

          ENDIF.


        WHEN 'PO_NUMBER'.

          "==================================================
          " 2. OPEN ME23N
          "==================================================
          IF x_alv-status = 'S' AND x_alv-po_number IS NOT INITIAL.

            SET PARAMETER ID 'BES' FIELD x_alv-po_number.
            CALL TRANSACTION 'ME23N' AND SKIP FIRST SCREEN.

          ELSE.

            MESSAGE 'Tidak ada detail untuk ditampilkan' TYPE 'I'.

          ENDIF.

      ENDCASE.

  ENDCASE.

ENDFORM.



*&---------------------------------------------------------------------*
*& Form f_slc
*&---------------------------------------------------------------------*

FORM f_slc .
  LOOP AT SCREEN.
    CASE 'X'.
      WHEN p_rbloc.
        IF screen-group1 = 'LOC'.
          screen-active = 1.
          screen-invisible = 0.
        ELSEIF screen-group1 = 'SRV'.
          screen-active = 0.
          screen-invisible = 1.
        ENDIF.

      WHEN p_rbsrv.
        IF screen-group1 = 'LOC'.
          screen-active = 0.
          screen-invisible = 1.
        ELSEIF screen-group1 = 'SRV'.
          screen-active = 1.
          screen-invisible = 0.
        ENDIF.
    ENDCASE.
    MODIFY SCREEN.
  ENDLOOP.
ENDFORM.

