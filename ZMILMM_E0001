REPORT zmil_material.
*TABLES: zmil_material, zmil_materialcat.
*deklarasi data utk select option aja==========
DATA: lv_nomat_ref TYPE zmil_material-nomat,
      lv_name_ref  TYPE zmil_material-name,
      lv_idcat_ref TYPE zmil_materialcat-idcat.

SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE TEXT-001.
  PARAMETERS: rb_mtn RADIOBUTTON GROUP g1 DEFAULT 'X' USER-COMMAND rad,
              rb_ins RADIOBUTTON GROUP g1,
              rb_upd RADIOBUTTON GROUP g1,
              rb_del RADIOBUTTON GROUP g1,
              rb_rpt RADIOBUTTON GROUP g1.
SELECTION-SCREEN END OF BLOCK b1.

SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME TITLE TEXT-002.
  PARAMETERS:
    p_name   TYPE zmil_material-name MODIF ID ins. "radio button

  SELECTION-SCREEN BEGIN OF LINE.
    SELECTION-SCREEN COMMENT (31) TEXT-004 MODIF ID ins. " Label ID Cat
    PARAMETERS: p_idcat TYPE zmil_materialcat-idcat MODIF ID ins . " Search Hel
    SELECTION-SCREEN COMMENT (40) lv_dsc MODIF ID ins. " desc cat
  SELECTION-SCREEN END OF LINE.

  PARAMETERS:
    p_price  TYPE zmil_material-price MODIF ID ins,
    p_curry  TYPE zmil_material-curry MODIF ID ins,
    p_weight TYPE zmil_material-weigh MODIF ID ins,
    p_meins  TYPE zmil_material-meins MODIF ID ins,
    p_stats  TYPE zmil_material-stats MODIF ID ins.
SELECTION-SCREEN END OF BLOCK b2.


SELECTION-SCREEN BEGIN OF BLOCK b3 WITH FRAME TITLE TEXT-003.
  PARAMETERS:
    p_noma_u TYPE zmil_material-nomat MODIF ID upd,
    p_name_u TYPE zmil_material-name MODIF ID upd,
    p_idca_u TYPE zmil_materialcat-idcat MODIF ID upd,
    p_pric_u TYPE zmil_material-price MODIF ID upd,
    p_curr_u TYPE zmil_material-curry MODIF ID upd,
    p_weig_u TYPE zmil_material-weigh MODIF ID upd,
    p_mein_u TYPE zmil_material-meins MODIF ID upd,
    p_stat_u TYPE zmil_material-stats MODIF ID upd.
SELECTION-SCREEN END OF BLOCK b3.

SELECTION-SCREEN BEGIN OF BLOCK b4 WITH FRAME TITLE TEXT-006.
  PARAMETERS:
  p_noma_d TYPE zmil_material-nomat MODIF ID del.
SELECTION-SCREEN END OF BLOCK b4.

SELECTION-SCREEN BEGIN OF BLOCK b5 WITH FRAME TITLE TEXT-005.
  SELECT-OPTIONS:
  s_noma_r FOR lv_nomat_ref MODIF ID rep NO-EXTENSION,"no input obo
  p_name_r FOR lv_name_ref MODIF ID rep, "bisa 22nya
  p_idca_r FOR lv_idcat_ref MODIF ID rep NO INTERVALS NO-EXTENSION. "just 1 value
  PARAMETERS:
  p_stat_r  TYPE zmil_material-stats MODIF ID rep.
SELECTION-SCREEN END OF BLOCK b5.

*1. INITIALIZATION (optional)
*2. AT SELECTION-SCREEN ON <field>
*3. AT SELECTION-SCREEN (general validation)
*4. AT SELECTION-SCREEN OUTPUT (dynamic screen)
*5. START-OF-SELECTION (main process)
*6. END-OF-SELECTION (optional)
*7. FORM / SUBROUTINE

  "---------------------------------------------------------
AT SELECTION-SCREEN ON p_idcat. "when idcat enter
  IF rb_ins = 'X' AND p_idcat IS NOT INITIAL.
    SELECT SINGLE catdesc
      FROM zmil_materialcat
      INTO @lv_dsc " kotak deskripsi
    WHERE idcat = @p_idcat. "samain dengan input
    IF sy-subrc <> 0.
      CLEAR lv_dsc. "bekas sblmnya/salah ambil desc
    ENDIF.
  ENDIF.
  IF  rb_ins = 'X' and p_idcat is not INITIAL.
      " Cek kategori
  SELECT SINGLE idcat
    FROM zmil_materialcat
    INTO @DATA(lv_idcat)
  WHERE idcat = @p_idcat.

  IF sy-subrc <> 0.
    MESSAGE 'Category tidak ditemukan' TYPE 'E'.
  ENDIF.

  ENDIF.
*=========================
*auto fill di update
AT SELECTION-SCREEN ON p_noma_u.
  IF rb_upd = 'X' AND p_noma_u IS NOT INITIAL.
    SELECT SINGLE *
      FROM zmil_material
      INTO @DATA(ls_mat)
    WHERE nomat = @p_noma_u.

    IF sy-subrc = 0.
      p_name_u = ls_mat-name.
      p_idca_u = ls_mat-idcat.
      p_pric_u = ls_mat-price.
      p_curr_u = ls_mat-curry.
      p_weig_u = ls_mat-weigh.
      p_mein_u = ls_mat-meins.
      p_stat_u = ls_mat-stats.
*      LEAVE SCREEN. "refresh

    ELSE.
      MESSAGE 'Material tidak ditemukan' TYPE 'E'.
      CLEAR: p_name_u, p_idca_u, p_pric_u, p_curr_u, p_weig_u, p_mein_u, p_stat_u.
    ENDIF.
  ENDIF.

