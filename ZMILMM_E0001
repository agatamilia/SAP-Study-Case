AT SELECTION-SCREEN.
  CASE sy-ucomm.
    WHEN 'ONLI'.
      IF p_name IS INITIAL OR p_idcat IS INITIAL.
        MESSAGE 'Field wajib diisi' TYPE 'E'. "'S' DISPLAY LIKE 'E'.
      ENDIF.
  ENDCASE.

