* dynamic screen=============
AT SELECTION-SCREEN OUTPUT. "do user-command
  LOOP AT SCREEN.
    IF ( rb_mtn = 'X' AND screen-group1 IS NOT INITIAL ) OR
      ( rb_ins = 'X' AND screen-group1 <> 'INS' ) OR "Not equal
       ( rb_upd = 'X' AND screen-group1 <> 'UPD' ) OR
       ( rb_del = 'X' AND screen-group1 <> 'DEL' ) OR
       ( rb_rpt = 'X' AND screen-group1 <> 'REP' ).

      " no hide elemen group kosong > radio button
      IF screen-group1 IS NOT INITIAL.
        screen-active = 0.
      ENDIF.
    ENDIF.
    MODIFY SCREEN.
  ENDLOOP.


* main process ke form
START-OF-SELECTION.
  CASE 'X'.
    WHEN rb_mtn.
      PERFORM f_mtn.
    WHEN rb_ins.
      PERFORM f_ins.
    WHEN rb_upd.
      PERFORM f_upd.
    WHEN rb_del.
      PERFORM f_del.
    WHEN rb_rpt.
      PERFORM f_rpt.
  ENDCASE.

*=========================
FORM f_ins.
*  IF p_name IS INITIAL OR p_idcat IS INITIAL.
*    MESSAGE 'Field wajib diisi' TYPE 'E'. "'S' DISPLAY LIKE 'E'.
*  ENDIF.
  DATA: lv_nomat TYPE zmil_material-nomat. "loc var 1 value



*  generate pk tcode snro
  CALL FUNCTION 'NUMBER_GET_NEXT'
    EXPORTING
      nr_range_nr = '01'
      object      = 'ZMIL_NOMAT'
    IMPORTING
      number      = lv_nomat.

  "loc struc 1 line
  DATA(ls_data) = VALUE zmil_material(
  nomat = lv_nomat
  name = p_name
  idcat = p_idcat
  price = p_price
  curry = p_curry
  weigh = p_weight
  meins = p_meins
  stats = p_stats
   ).

  INSERT zmil_material FROM @ls_data.

  IF sy-subrc = 0.
    MESSAGE |Material { lv_nomat } berhasil dibuat| TYPE 'S'.
  ELSE.
    MESSAGE 'Insert failed' TYPE 'E'.
  ENDIF.
ENDFORM.

"=======================
FORM f_upd.
  IF p_noma_u IS INITIAL.
    MESSAGE 'Pilih Nomor Material yang ingin di-update!' TYPE 'E'.
  ENDIF.

  UPDATE zmil_material
  SET name = @p_name_u,
  idcat = @p_idca_u,
  price = @p_pric_u,
  curry = @p_curr_u,
  weigh = @p_weig_u,
  meins = @p_mein_u,
  stats = @p_stat_u
  WHERE nomat = @p_noma_u.

  IF sy-subrc = 0.
    MESSAGE 'Update Sukses' TYPE 'S'.
  ELSE.
    MESSAGE 'Gagal update' TYPE 'E'.
  ENDIF.
ENDFORM.

*=====================
FORM f_del.
  IF p_noma_d IS INITIAL.
    MESSAGE 'Isi Nomor Material yang ingin dihapus' TYPE 'E'.
    RETURN.
  ENDIF.
  DELETE FROM zmil_material WHERE nomat = @p_noma_d.
  IF sy-subrc = 0.
    MESSAGE 'Data Berhasil Dihapus!' TYPE 'S'.
  ELSE.
    MESSAGE 'Data tidak ditemukan di database' TYPE 'E'.
  ENDIF.
ENDFORM.


*====================
FORM f_rpt.
  SELECT * FROM zvmil_material INTO TABLE @DATA(lt_report)" get row to lt
  WHERE nomat IN @s_noma_r. "range nomat

  IF sy-subrc <> 0 OR lt_report IS INITIAL. "no data in database and lt
    MESSAGE 'Tidak ada data untuk ditampilkan' TYPE 'E'.
    RETURN.
  ENDIF.

  cl_salv_table=>factory( "class for report, factory table maker
  IMPORTING r_salv_table = DATA(lo_alv) "get rpt > local obj
  CHANGING  t_table      = lt_report ). "can modif/changing raw data for import
  lo_alv->display( ).
ENDFORM.


*===============================
FORM f_mtn.
  CALL FUNCTION 'VIEW_MAINTENANCE_CALL' "func TMG
    EXPORTING
      action    = 'U' "export update
      view_name = 'ZMIL_MATERIALCAT' "view table
    EXCEPTIONS
      OTHERS    = 15. "error other sy-subrc > no TMG
ENDFORM.
