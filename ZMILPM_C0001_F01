"========================================================
" GET DATA FROM FUNCTION MODULE
"========================================================
FORM f_process_data.

  CALL FUNCTION 'ZMILFM_0001'
    EXPORTING
      fi_qmnum  = s_not[] "itab for many value input, dipakai kalau ambil isi table manual
      fi_aufnr  = s_mo[]
      fi_rb_not = rb_not "one value
      fi_rb_mo  = rb_mo
    IMPORTING
      fe_notif  = t_not
    TABLES
      ft_mo_h   = t_mo_h
      ft_mo_i   = t_mo_i.

ENDFORM.


"========================================================
" USER COMMAND (DOUBLE CLICK / HOTSPOT)
"========================================================
FORM f_ucomm USING
      r_ucomm "param input to form
      LIKE sy-ucomm " var sap > kode tombol / aksi user
      rs_selfield "var info alv
  TYPE slis_selfield. "struct sap for alv event

  CASE r_ucomm. "cek user do

    WHEN '&IC1'. " event Double Click / Hotspot |& → system command | IC → Interactive Command | 1 → tipe event (double click)

      "========================
      " NOTIFICATION → IW23
      "========================
      IF rb_not = 'X'.

        READ TABLE t_not INTO DATA(ls_not)
          INDEX rs_selfield-tabindex. "get base on line num user click

        IF sy-subrc = 0.
          SET PARAMETER ID 'IQM' FIELD ls_not-qmnum. "send qmnum
          CALL TRANSACTION 'IW23' AND SKIP FIRST SCREEN. "call tran, display not, open not immediately
        ENDIF.

      ENDIF.


      "========================
      " ORDER → IW33
      "========================
      IF rb_mo = 'X'.

        READ TABLE t_mo_h INTO DATA(ls_mo)
          INDEX rs_selfield-tabindex.

        IF sy-subrc = 0.
          SET PARAMETER ID 'ANR' FIELD ls_mo-aufnr."F1 tech info for detail pram id
          CALL TRANSACTION 'IW33' AND SKIP FIRST SCREEN. "open detail order rn
        ENDIF.

      ENDIF.

  ENDCASE.

ENDFORM.


"========================================================
" DISPLAY NOTIFICATION (ALV GRID)
