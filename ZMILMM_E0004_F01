FORM normalize_unit CHANGING p_unit TYPE meins
                             p_error TYPE abap_bool
                             p_msg TYPE string.

  TRANSLATE p_unit TO UPPER CASE.
  CONDENSE p_unit.

  "manual mapping unit PC(WAJIB kalau dari CSV bebas)
  CASE p_unit.
    WHEN 'PCS' OR 'PC' OR 'PCE'.
      p_unit = 'PC'.
  ENDCASE.

  CALL FUNCTION 'CONVERSION_EXIT_CUNIT_INPUT'
    EXPORTING
      input  = p_unit
    IMPORTING
      output = p_unit
    EXCEPTIONS
      OTHERS = 1.

  SELECT SINGLE msehi "field uom
  FROM t006 "table sap uom
  INTO @DATA(lv_check)
  WHERE msehi = @p_unit.

  IF sy-subrc <> 0.
    p_error = abap_true.
    p_msg = 'Unit tidak terdaftar di SAP'.
  ENDIF.

ENDFORM.

FORM f_rfile.

  DATA: lv_qty      TYPE string,
        lv_date_str TYPE string,
        lv_day      TYPE string,
        lv_mon      TYPE string,
        lv_year     TYPE string,
        lv_err      TYPE abap_bool,
        lv_msg      TYPE string,
        lv_unit     TYPE meins.

  "========================
  " 1. PARSE FILE > t_up
  "========================
  LOOP AT t_data INTO d_line.

    CLEAR: x_up, t_split.

    "skip header read
    IF sy-tabix = 1.
      CONTINUE.
    ENDIF.

    SPLIT d_line AT ';' INTO TABLE t_split.
    "mapping array to struct x_up
    READ TABLE t_split INDEX 1 INTO x_up-no.
    READ TABLE t_split INDEX 2 INTO x_up-doc_type.
    READ TABLE t_split INDEX 3 INTO x_up-vendor.
    READ TABLE t_split INDEX 4 INTO x_up-purch_org.
    READ TABLE t_split INDEX 5 INTO x_up-pur_group.
    READ TABLE t_split INDEX 6 INTO x_up-material.
    READ TABLE t_split INDEX 7 INTO x_up-plant.

    "STRING → DIKONVERSI → NUMERIC
    READ TABLE t_split INDEX 8 INTO lv_qty.
    x_up-quantity = lv_qty. "

    READ TABLE t_split INDEX 9 INTO lv_unit.

    PERFORM normalize_unit CHANGING lv_unit lv_err lv_msg .

    x_up-po_unit = lv_unit.

    READ TABLE t_split INDEX 10 INTO x_up-gl_account.
    READ TABLE t_split INDEX 11 INTO x_up-bus_area.
    READ TABLE t_split INDEX 12 INTO x_up-costcenter.
    READ TABLE t_split INDEX 13 INTO lv_date_str.

    IF lv_date_str IS NOT INITIAL.

      CONDENSE lv_date_str.

      REPLACE ALL OCCURRENCES OF '/' IN lv_date_str WITH '.'.
      REPLACE ALL OCCURRENCES OF '-' IN lv_date_str WITH '.'.

      SPLIT lv_date_str AT '.' INTO lv_day lv_mon lv_year.

      IF lv_year IS INITIAL. " berarti format tanpa separator
        lv_day  = lv_date_str+0(2).
        lv_mon  = lv_date_str+2(2).
        lv_year = lv_date_str+4(4).
      ENDIF.

      x_up-deliv_date = |{ lv_year }{ lv_mon WIDTH = 2 PAD = '0' }{ lv_day WIDTH = 2 PAD = '0' }|. "plus 0 jika 1 char

    ENDIF.

    " NORMALISASI=====================
    "alpha IN = external to internal 0 for fixed length | cek: domain > routine
    x_up-vendor     = |{ x_up-vendor ALPHA = IN }|.
    x_up-material   = |{ x_up-material ALPHA = IN }|.
    x_up-gl_account = |{ x_up-gl_account ALPHA = IN }|.
    x_up-costcenter = |{ x_up-costcenter ALPHA = IN }|.

    APPEND x_up TO t_up.

  ENDLOOP.

ENDFORM.

