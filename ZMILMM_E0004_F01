*&---------------------------------------------------------------------*
*& Form f_user_command
*&---------------------------------------------------------------------*

FORM f_user_command USING r_ucomm     TYPE sy-ucomm
                          rs_selfield TYPE slis_selfield.

  CASE r_ucomm.

    WHEN 'CHEC'.
      PERFORM f_check.
      rs_selfield-refresh = 'X'.

    WHEN 'POST'.
      PERFORM f_post.
      rs_selfield-refresh = 'X'.

    WHEN '&IC1'. "double click / hotspot

      CLEAR x_alv.

      READ TABLE t_alv INTO x_alv INDEX rs_selfield-tabindex.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.

      CASE rs_selfield-fieldname.

*        WHEN 'MESSAGE'.
*
*          DATA lv_text TYPE string.
*
*          IF x_alv-message IS NOT INITIAL.
*
*            CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
*              EXPORTING
*                titel     = 'Detail Error per Field'
*                textline1 = lv_text.
*
*          ELSE.
*
*            MESSAGE x_alv-message TYPE 'I'.
*
*          ENDIF.
        WHEN 'MESSAGE'.

          DATA: lv_po   TYPE ebeln,
                lv_text TYPE string,
                lv_off  TYPE i,
                lv_len  TYPE i.
          lv_text = x_alv-message.

          "========================
          " SUCCESS -> OPEN ME23N
          "========================
          IF x_alv-status = 'S'.

            "Cari nomor PO 10 digit dari message
            FIND REGEX '[0-9]+' IN lv_text
              MATCH OFFSET lv_off
              MATCH LENGTH lv_len.

            IF sy-subrc = 0.

              lv_po = lv_text+lv_off(lv_len).

              SET PARAMETER ID 'BES' FIELD lv_po.
              CALL TRANSACTION 'ME23N' AND SKIP FIRST SCREEN.

            ELSE.

              MESSAGE lv_text TYPE 'I'.

            ENDIF.

          ELSE.

            "========================
            " ERROR -> POPUP DETAIL
            "========================
            CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
              EXPORTING
                titel     = 'Detail Message'
                textline1 = lv_text.

          ENDIF.


      ENDCASE.

  ENDCASE.

ENDFORM.
